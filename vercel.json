{
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/editor/[...path].js": {
      "includeFiles": "{data.json,data.js,*.html,components/**,scripts/**,assets/**}"
    }
  },
  "rewrites": [
    { "source": "/admin", "destination": "/admin/studio.html" },
    { "source": "/admin/", "destination": "/admin/studio.html" },
    { "source": "/admin.html", "destination": "/admin/studio.html" }
  ]
}
